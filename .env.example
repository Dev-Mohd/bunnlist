# Supabase PostgreSQL pooler connection for runtime queries.
# Use the transaction pooler first; switch to the session pooler if PrismaPg shows prepared-statement issues.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Supabase direct or session pooler connection for Prisma migrations and schema operations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Apple Sign In (optional — omit all four to disable Apple login)
APPLE_CLIENT_ID="com.yourcompany.bunnlist"
APPLE_TEAM_ID="XXXXXXXXXX"
APPLE_KEY_ID="XXXXXXXXXX"
# Paste the full PEM content of your .p8 key with literal \n between lines:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=""

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"

GEMINI_API_KEY=""

# Optional: makes this user ADMIN during seed.
SEED_ADMIN_EMAIL="admin@bunnlist.com"
