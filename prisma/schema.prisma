generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BrewMethod {
  ESPRESSO
  V60
  CHEMEX
  AEROPRESS
  FRENCH_PRESS
  COLD_BREW
  OTHER
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum CoffeeProcess {
  NATURAL
  WASHED
  HONEY
  ANAEROBIC
  WET_HULLED
  CARBONIC_MACERATION
  EXPERIMENTAL
  MIXED
  OTHER
}

enum RateLimitAction {
  CREATE_REVIEW
  UPDATE_REVIEW
  CREATE_COFFEE_LOT
}

enum ImportStatus {
  PENDING
  REVIEWED
  SAVED
  REJECTED
}

enum CoffeeImageType {
  OFFICIAL
  PLACEHOLDER
  USER_UPLOADED
  NONE
}

enum ImagePermissionStatus {
  APPROVED
  PENDING
  REJECTED
  PLACEHOLDER_ONLY
}

enum CoffeeImageSource {
  ROASTERY_WEBSITE
  ROASTERY_PROVIDED
  INSTAGRAM
  USER_UPLOAD
  PLACEHOLDER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  locale        String    @default("ar")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  reviews           Review[]
  createdCoffeeLots CoffeeLot[]      @relation("CreatedCoffeeLots")
  rateLimitEvents   RateLimitEvent[]
  importJobs        ImportJob[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Roaster {
  id        String   @id @default(cuid())
  name      String
  nameAr    String
  slug      String   @unique
  country   String?
  cityAr    String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coffeeLots CoffeeLot[]

  @@index([name])
}

model OriginCountry {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String?
  isoCode   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coffeeLots CoffeeLot[]

  @@index([nameAr])
}

model CoffeeLot {
  id                     String                @id @default(cuid())
  slug                   String                @unique
  name                   String
  nameAr                 String
  roasterId              String
  originCountryId        String
  region                 String?
  regionAr               String?
  farm                   String?
  producer               String?
  variety                String?
  process                CoffeeProcess
  processLabel           String?
  roastLevel             String?
  altitudeMeters         Int?
  flavorNotes            String[]
  recommendedBrewMethods BrewMethod[]
  imagePath              String?
  imageUrl               String?               @db.Text
  imageType              CoffeeImageType       @default(NONE)
  imagePermissionStatus  ImagePermissionStatus @default(PLACEHOLDER_ONLY)
  imageSource            CoffeeImageSource     @default(PLACEHOLDER)
  imageCredit            String?
  imageSourceUrl         String?               @db.Text
  imagePermissionNote    String?               @db.Text
  imageApprovedAt        DateTime?
  originalImageUrl       String?               @db.Text
  storedImageUrl         String?               @db.Text
  imageStorageProvider   String?
  imageStoredAt          DateTime?
  description            String?               @db.Text
  descriptionAr          String?               @db.Text
  averageRating          Decimal               @default(0) @db.Decimal(3, 2)
  reviewCount            Int                   @default(0)
  publishedAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  createdById            String?

  roaster       Roaster             @relation(fields: [roasterId], references: [id], onDelete: Restrict)
  originCountry OriginCountry       @relation(fields: [originCountryId], references: [id], onDelete: Restrict)
  createdBy     User?               @relation("CreatedCoffeeLots", fields: [createdById], references: [id], onDelete: SetNull)
  reviews       Review[]
  brewStats     CoffeeLotBrewStat[]
  importedFrom  ImportedCoffee[]

  @@index([roasterId])
  @@index([originCountryId])
  @@index([process])
  @@index([averageRating])
  @@index([reviewCount])
  @@index([createdAt])
}

model ImportJob {
  id            String       @id @default(cuid())
  sourceUrl     String       @db.Text
  normalizedUrl String
  status        ImportStatus @default(PENDING)
  httpStatus    Int?
  rawHtmlSize   Int?
  rawText       String?      @db.Text
  errorMessage  String?      @db.Text
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  importedCoffee ImportedCoffee?

  @@index([normalizedUrl])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

model ImportedCoffee {
  id                 String       @id @default(cuid())
  importJobId        String       @unique
  status             ImportStatus @default(PENDING)
  coffeeName         String?
  roasteryName       String?
  originCountry      String?
  region             String?
  farmName           String?
  producerName       String?
  process            String?
  variety            String?
  tastingNotes       String[]
  roastLevel         String?
  brewMethods        String[]
  price              Decimal?     @db.Decimal(10, 2)
  currency           String?
  weightGrams        Int?
  productUrl         String?      @db.Text
  imageUrl           String?      @db.Text
  availability       String?
  descriptionSummary String?      @db.Text
  confidence         Json?
  savedCoffeeLotId   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  importJob      ImportJob  @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  savedCoffeeLot CoffeeLot? @relation(fields: [savedCoffeeLotId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([savedCoffeeLotId])
}

model CoffeeLotBrewStat {
  id            String     @id @default(cuid())
  coffeeLotId   String
  brewMethod    BrewMethod
  averageRating Decimal    @default(0) @db.Decimal(3, 2)
  reviewCount   Int        @default(0)
  wouldBuyAgain Int        @default(0)
  updatedAt     DateTime   @updatedAt

  coffeeLot CoffeeLot @relation(fields: [coffeeLotId], references: [id], onDelete: Cascade)

  @@unique([coffeeLotId, brewMethod])
  @@index([brewMethod])
  @@index([averageRating])
}

model Review {
  id            String       @id @default(cuid())
  coffeeLotId   String
  userId        String
  rating        Int
  brewMethod    BrewMethod
  wouldBuyAgain Boolean
  body          String?      @db.Text
  status        ReviewStatus @default(PUBLISHED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  coffeeLot CoffeeLot @relation(fields: [coffeeLotId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coffeeLotId, userId])
  @@index([coffeeLotId, status])
  @@index([userId])
  @@index([brewMethod])
  @@index([rating])
  @@index([createdAt])
}

model RateLimitEvent {
  id        String          @id @default(cuid())
  action    RateLimitAction
  userId    String?
  ipHash    String?
  targetId  String?
  createdAt DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action, userId, createdAt])
  @@index([action, ipHash, createdAt])
  @@index([targetId])
}

// --- Mobile auth (C03) — additive; does not touch existing web models. ---

/// A refresh-token family (one mobile session). Tokens are stored hashed.
model MobileSession {
  id             String   @id
  accountId      String
  deviceId       String
  currentHash    String
  issuedAt       DateTime
  consumedHashes String[]
  revoked        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId])
}

/// One active email login code per address. The code is stored hashed (bound to
/// the email); the plaintext is emailed and never persisted. Attempt- and
/// resend-limited by the app logic.
model MobileEmailOtp {
  email      String   @id
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// One account's saved state for a lot (the mobile "collection"): owned / favorite
/// / want-to-try / tried. Keyed by (account, lot), synced from the app.
model MobileCollectionEntry {
  accountId  String
  lotId      String
  owned      Boolean  @default(false)
  favorite   Boolean  @default(false)
  wantsToTry Boolean  @default(false)
  tried      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([accountId, lotId])
  @@index([accountId])
}

/// A user-submitted coffee suggestion from the app (pending review).
model MobileCoffeeSubmission {
  id               String    @id @default(cuid())
  accountId        String
  name             String
  roasterName      String
  originName       String?
  nameEn           String?
  roasterNameEn    String?
  process          String?
  roastLevel       String?
  flavorNotes      String[]  @default([])
  /// Object path in the private "suggestion-images" bucket (a background-removed product photo).
  photoPath        String?
  note             String?   @db.Text
  /// Shown publicly with the lot once approved ("ملاحظة المكتشف").
  publicNote       String?   @db.Text
  /// Curated batch imports (accountId "catalog"): idempotency key, source page,
  /// extraction confidence, and lot details carried over on approval.
  importKey        String?   @unique
  sourceUrl        String?   @db.Text
  sourceConfidence Float?
  extras           Json?
  status           String    @default("PENDING")
  /// Set on approval: the published lot this suggestion became.
  approvedLotId    String?
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([accountId])
  @@index([status])
  @@index([approvedLotId])
}

/// A brew experience logged from the app against a published lot. Mirrors the
/// app's BrewExperience: its stars rate this attempt only (never the lot average);
/// lifecycle draft -> published <-> unpublished, deleted is final. clientId makes
/// creation idempotent per account.
model MobileBrewExperience {
  id           String   @id @default(cuid())
  accountId    String
  clientId     String
  lotId        String
  methodCode   String
  stars        Int
  brewedAt     DateTime
  note         String   @default("") @db.Text
  state        String   @default("draft")
  revision     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// «حضّر»'s brew log, all optional: the recipe followed (id, title, where it came
  /// from), the grind actually used on which guide grinder, the numbers, the time
  /// brewed, and how it tasted (sour/bitter/weak/strong/balanced).
  recipeId     String?
  recipeTitle  String?
  recipeSource String?
  grinderId    String?
  grindSetting String?
  doseGrams    Float?
  waterGrams   Float?
  brewSeconds  Int?
  taste        String?

  @@unique([accountId, clientId])
  @@index([accountId, lotId])
  @@index([lotId, state])
}

/// A brew recipe from the app. Mirrors the app's Recipe: lotId is optional (no lot =
/// a general recipe); water is stored per step and the total is derived. Lifecycle
/// draft -> published <-> unpublished, deleted is final; publishing is validated.
/// Edits bump version; a copy records its source and the version it copied.
model MobileRecipe {
  id            String    @id @default(cuid())
  accountId     String
  clientId      String
  lotId         String?
  title         String
  methodCode    String
  temperature   String    @default("hot")
  doseGrams     Float?
  hotWaterGrams Float?
  iceGrams      Float?
  yieldGrams    Float?
  waterTempC    Float?
  grinder       String    @default("")
  grindSetting  String    @default("")
  grinderModel  String?
  grindLevel    String?
  grindMicrons  Int?
  brewer        String    @default("")
  filterType    String?
  roastLevel    String?
  restDays      Int?
  waterType     String?
  waterBrand    String    @default("")
  waterTdsPpm   Int?
  beverageTds   Float?
  milkDrink     String?
  milkType      String?
  milkGrams     Float?
  notes         String    @default("") @db.Text
  steps         Json      @default("[]")
  sourceId      String?
  sourceVersion Int?
  version       Int       @default(1)
  state         String    @default("draft")
  revision      Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([accountId, clientId])
  @@index([accountId])
  @@index([state, publishedAt])
  @@index([lotId, state])
}

/// One AI bag-photo scan, for the per-account daily limit. The photo itself is
/// never stored.
model MobileAiScan {
  id           String   @id @default(cuid())
  accountId    String
  isCoffeeBag  Boolean  @default(false)
  matchedCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([accountId, createdAt])
}

/// The app's public profile for an account: @username (stored lowercase, unique;
/// shown instead of the raw account id), display name, bio and avatar, and when
/// the first-run setup was finished.
model MobileProfile {
  accountId           String    @id
  username            String?   @unique
  displayName         String?
  bio                 String?
  avatarPath          String?
  onboardedAt         DateTime?
  hideFromLeaderboard Boolean   @default(false)
  /// "everyone" | "followers" | "me" — see lib/mobile/profile.ts VISIBILITY.
  followersVisibility String    @default("everyone")
  followingVisibility String    @default("everyone")
  activityVisibility  String    @default("everyone")
  /// A private account approves each follower; its activity is for followers only.
  isPrivate           Boolean   @default(false)
  /// «مطحنتي»: a MobileGrinder id, for grind conversions.
  grinderId           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// The points ledger. One row per rewarded action (unique per account, kind and
/// the thing it was for), plus zero-point "activity" rows (one per day) that make
/// up the streak. Totals are always summed from here, never stored.
model MobilePointEvent {
  id        String   @id @default(cuid())
  accountId String
  kind      String
  refId     String
  points    Int
  day       String
  createdAt DateTime @default(now())

  @@unique([accountId, kind, refId])
  @@index([accountId, day])
  @@index([createdAt])
}

/// One account following another.
model MobileFollow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
}

/// A pending follow of a private account, until its owner accepts or declines.
model MobileFollowRequest {
  requesterId String
  targetId    String
  createdAt   DateTime @default(now())

  @@id([requesterId, targetId])
  @@index([targetId])
}

/// Server idempotency record keyed by (owner, operation, device clientId).
model MobileIdempotency {
  ownerId     String
  operation   String
  clientId    String
  payloadHash String
  state       String
  resourceId  String?
  response    String?   @db.Text
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([ownerId, operation, clientId])
}

/// A phone's APNs device token for an account. environment: "sandbox" (debug
/// builds) or "production".
model MobilePushDevice {
  token       String   @id
  accountId   String
  environment String   @default("production")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}

/// Which push notifications an account wants. No row = all on.
model MobileNotificationSettings {
  accountId          String   @id
  newFollower        Boolean  @default(true)
  submissionApproved Boolean  @default(true)
  submissionRejected Boolean  @default(true)
  reviewHelpful      Boolean  @default(true)
  recipeLiked        Boolean  @default(true)
  weeklySummary      Boolean  @default(true)
  /// News from the BunnList team (admin broadcasts).
  announcements      Boolean  @default(true)
  /// Someone commented on my brew or recipe.
  comments           Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

/// "مفيد" on a review (targetType "review") or "أعجبني" on a recipe ("recipe").
/// ownerId is the liked thing's author.
model MobileLike {
  accountId  String
  targetType String
  targetId   String
  ownerId    String
  createdAt  DateTime @default(now())

  @@id([accountId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([ownerId])
}

/// A label on a published lot: "luxury", "infused" or "decaf" (note: why).
model MobileLotTag {
  lotId     String
  tag       String
  note      String?
  createdAt DateTime @default(now())

  @@id([lotId, tag])
  @@index([tag])
}

/// A report on someone's content (a review, a recipe, a discoverer's note, a
/// profile), for the admin console. One open report per reporter and target.
model MobileReport {
  id         String    @id @default(cuid())
  reporterId String
  /// "review" | "recipe" | "note" | "profile" — see lib/mobile/reports.ts.
  targetType String
  /// Review id, recipe id, lot id (for its discoverer's note) or account id.
  targetId   String
  reason     String
  details    String?
  /// "open" | "removed" | "dismissed"
  status     String    @default("open")
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

/// An account barred from posting (reviews, recipes, suggestions, profile text)
/// by an admin, until `until` or indefinitely. Reading the app is unaffected.
model MobileSuspension {
  accountId String    @id
  reason    String
  until     DateTime?
  createdBy String
  createdAt DateTime  @default(now())
}

/// A push notification an admin sent to many accounts, kept as a log.
model MobileBroadcast {
  id        String   @id @default(cuid())
  title     String
  body      String
  /// "test" | "all" | "active30"
  audience  String
  accounts  Int
  delivered Int
  createdBy String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// The grinder guide: every grinder people can pick as «مطحنتي». Names come from
/// the bundled list; specs are filled in from manufacturers' own sources (kept in
/// `sources`) and edited in the admin console. Photos are provided by the owner.
model MobileGrinder {
  id                String   @id
  brand             String
  model             String
  variant           String?
  /// "hand" | "electric" | "single_dose" | "built_in" | "espresso" | "commercial"
  category          String
  /// "clicks" | "stepped" | "stepless" | "timer"; null until verified.
  adjustment        String?
  rangeMin          Float?
  rangeMax          Float?
  clicksPerRotation Int?
  micronsPerStep    Float?
  zeroGuideAr       String?  @db.Text
  notesAr           String?  @db.Text
  /// [{ label, url }] where each spec came from.
  sources           Json     @default("[]")
  imageUrl          String?  @db.Text
  imageCredit       String?
  published         Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category, sortOrder])
}

/// Admin overrides for the home's trending coffees: "pin" puts a coffee on the
/// list (pins first, oldest pin first), "hide" keeps it off.
model MobileTrendingOverride {
  lotId     String   @id
  mode      String
  createdBy String
  createdAt DateTime @default(now())
}

/// Two coffees an admin said are different (kept in id order: lotA < lotB), so the duplicate finder skips them.
model MobileDuplicateDismissal {
  lotA      String
  lotB      String
  createdAt DateTime @default(now())

  @@id([lotA, lotB])
}

/// The slug of a coffee merged into another; old links resolve to the one that stayed.
model MobileLotRedirect {
  fromSlug  String   @id
  toLotId   String
  createdAt DateTime @default(now())

  @@index([toLotId])
}

/// A roaster's own brew recipe for a coffee, read from its product page text.
model MobileRoasterRecipe {
  id        String   @id @default(cuid())
  lotId     String
  position  Int      @default(0)
  /// V60 | ESPRESSO | CHEMEX | AEROPRESS | XBLOOM
  method    String
  /// HOT | ICED
  serve     String   @default("HOT")
  /// An xBloom recipe's share link (its numbers live on xBloom's page).
  link      String?
  tool      String?
  /// Null only for an xBloom link.
  doseG     Float?
  waterMl   Int?
  tempC     Int?
  timeSec   Int?
  grind     String?
  ratio     Float?
  steps     String[] @default([])
  createdAt DateTime @default(now())

  @@index([lotId])
}

/// The weekly challenge an admin sets: do an action (brew, rate or collect) on
/// `target` different coffees matching the filters, between startsAt and endsAt.
model MobileChallenge {
  id           String   @id @default(cuid())
  titleAr      String
  subtitleAr   String?
  emoji        String?
  /// brew | rate | collect
  action       String
  originCode   String?
  process      String?
  roasterSlug  String?
  flavorFamily String?
  target       Int      @default(1)
  points       Int      @default(50)
  startsAt     DateTime
  endsAt       DateTime
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([startsAt, endsAt])
}

/// Someone who finished a challenge (rewarded once).
model MobileChallengeCompletion {
  challengeId String
  accountId   String
  completedAt DateTime @default(now())

  @@id([challengeId, accountId])
  @@index([challengeId])
}

/// A comment on a published brew or recipe. Soft-deleted by its author, the
/// post's owner or an admin.
model MobileComment {
  id         String    @id @default(cuid())
  /// brew | recipe
  targetType String
  targetId   String
  accountId  String
  body       String    @db.Text
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([targetType, targetId, createdAt])
  @@index([accountId, createdAt])
}
